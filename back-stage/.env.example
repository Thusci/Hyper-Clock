HA_URL=http://homeassistant:8123
HA_TOKEN=replace-with-a-long-lived-access-token
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
# While set, this IS the account's password (applied on every login). Remove it to manage the account in the UI.
BOOTSTRAP_ADMIN_PASSWORD=replace-on-first-login
# password = username + password; totp = username + authenticator code (the password is only used once, to bind it)
AUTH_METHOD=password
ALLOW_WAN=false
# Only enable behind the bundled gateway or another trusted reverse proxy.
TRUST_PROXY_HEADERS=false
COOKIE_SECURE=false
WATCH_FACE_ORIGIN=http://127.0.0.1:3000
KIOSK_SHARED_SECRET=replace-with-the-same-32-character-secret-as-watch-face
SYSTEM_API_ENABLED=false
# Q775 sidecar (daemon/): screen on/off via the kernel backlight. Token = [server].token in /etc/q775-daemon/config.toml
Q775_SIDECAR_URL=http://127.0.0.1:8765
Q775_SIDECAR_TOKEN=
DISPLAY_OFF_COMMAND=/opt/hyper-clock/bin/display-off
DISPLAY_ON_COMMAND=/opt/hyper-clock/bin/display-on
